<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.hotkeysForActivatingSiblingsInDashToPanel"
    path="/org/gnome/shell/extensions/hotkeysForActivatingSiblingsInDashToPanel/">
    <!-- If you make any changes to must run glib-compile-schemas schemas/ in the directory of the extension -->
    <key type="as" name="activate-left">
      <default><![CDATA[['<Super>Left']]]></default>
      <summary>Keybinding to activate left window</summary>
      <description>
        Activate left window with this key.
      </description>
    </key>
    <key type="as" name="activate-right">
      <default><![CDATA[['<Super>Right']]]></default>
      <summary>Keybinding to activate right window</summary>
      <description>
        Activate left window with this key.
      </description>
    </key>
  </schema>
</schemalist>


